# SiliconFlow embedding service configuration
EMBEDDING_API_URL=https://api.siliconflow.cn/v1/embeddings
EMBEDDING_API_KEY=replace-with-token
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_TIMEOUT=60
CHUNK_FLUSH_THRESHOLD=20
CHUNK_WORKERS=16

# Chroma storage location (unified ingestion paths)
CHROMA_PATH=output/ingestion/chroma
CHROMA_COLLECTION=ingestion_docs
