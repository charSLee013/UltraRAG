# Embedding service configuration (required)
EMBEDDING_API_URL=https://api.siliconflow.cn/v1/embeddings
EMBEDDING_API_KEY=replace-with-token
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_TIMEOUT=60

# Storage locations (env-first, single path)
INGESTION_SQLITE_PATH=output/ingestion/sqlite/docs.sqlite
CHROMA_PATH= output/modelscope_docs/chroma
CHROMA_COLLECTION=modelscope_docs
